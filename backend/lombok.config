# Stop Lombok from looking for configs further up the tree.
config.stopBubbling = true

# Mark all Lombok-generated members so coverage tools and static
# analysers can exclude them — they're already covered by the Lombok
# project's own test suite.
lombok.addLombokGeneratedAnnotation = true

# Force constructor injection style: never generate field-level
# @Autowired-style helpers; we use Lombok only on entities and DTOs.
lombok.anyConstructor.addConstructorProperties = true

# Be explicit about accessor naming so IDEs without the plugin still
# see deterministic method names in error messages.
lombok.accessors.fluent = false
lombok.accessors.chain = false
