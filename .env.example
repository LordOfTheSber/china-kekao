# Copy to `.env` for `docker compose up` and adjust as needed.

# --- PostgreSQL --------------------------------------------------------
POSTGRES_DB=kekao
POSTGRES_USER=kekao
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_PORT=5432

# --- Backend -----------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
LOG_LEVEL_APP=INFO

# Connection pool tuning (optional)
DB_POOL_MAX=10
DB_POOL_MIN=2

# --- JWT (used from TASK-005 onwards) ----------------------------------
# Provide RS256 keys as PEM strings or file paths once auth is wired in.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# --- Frontend (TASK-017+) ---------------------------------------------
FRONTEND_PORT=5173
