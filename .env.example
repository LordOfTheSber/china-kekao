# Copy to `.env` for `docker compose up` and adjust as needed.

# --- PostgreSQL --------------------------------------------------------
POSTGRES_DB=kekao
POSTGRES_USER=kekao
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_PORT=5432

# --- Backend -----------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
LOG_LEVEL_APP=INFO

# Connection pool tuning (optional)
DB_POOL_MAX=10
DB_POOL_MIN=2

# --- JWT (TASK-005) ----------------------------------------------------
# RS256 keys, PEM-encoded. Generate once with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# If left empty, the backend generates an ephemeral keypair on each start
# (tokens become invalid after restart — only acceptable in dev).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=china-kekao
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# Auth rate limiting (per-IP, 5 attempts / 15 minutes)
AUTH_RL_CAPACITY=5
AUTH_RL_WINDOW=PT15M

# --- Frontend (TASK-017+) ---------------------------------------------
FRONTEND_PORT=5173
